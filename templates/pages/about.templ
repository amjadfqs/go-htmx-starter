package pages

import "github.com/amjadfqs/go-htmx-starter/templates/components"

templ About() {
	@components.Layout("About") {
		<div class="max-w-lg mx-auto my-8 p-6 bg-white rounded-lg shadow-md">
			<h1 class="text-3xl font-bold mb-6 text-center">About This Project</h1>
			<p class="mb-4 text-gray-700">
				This starter template combines the power of Go's performance with the simplicity of HTMX for dynamic interfaces.
			</p>
			<h2 class="text-xl font-semibold mt-6 mb-2">Technologies Used:</h2>
			<ul class="list-disc pl-5 space-y-1 text-gray-700">
				<li>Go - Backend language</li>
				<li>HTMX - Frontend interactions without JavaScript</li>
				<li>Templ - HTML templating for Go</li>
				<li>Tailwind CSS - Utility-first CSS framework</li>
				<li>Air - Hot reloading during development</li>
			</ul>
			<div class="mt-6">
				<a href="/" class="text-blue-500 hover:text-blue-700">← Back to home</a>
			</div>
		</div>
	}
}
