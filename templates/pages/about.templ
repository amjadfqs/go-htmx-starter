package pages

import "github.com/amjadfqs/go-htmx-starter/templates/components"

templ About() {
	@components.Layout("About") {
		<div class="max-w-lg mx-auto my-8 p-6 bg-gray-800 border border-gray-700 rounded-lg shadow-lg">
			<h1 class="text-3xl font-bold mb-6 text-center text-blue-400">About This Project</h1>
			<p class="mb-4 text-gray-300">
				This starter template combines the power of Go's performance with the simplicity of HTMX for dynamic interfaces.
			</p>
			<h2 class="text-xl font-semibold mt-6 mb-3 text-gray-200">Technologies Used:</h2>
			<ul class="list-disc pl-5 space-y-2 text-gray-300">
				<li><span class="font-medium text-gray-200">Go</span> - Backend language</li>
				<li><span class="font-medium text-gray-200">HTMX</span> - Frontend interactions without JavaScript</li>
				<li><span class="font-medium text-gray-200">Templ</span> - HTML templating for Go</li>
				<li><span class="font-medium text-gray-200">Tailwind CSS</span> - Utility-first CSS framework</li>
				<li><span class="font-medium text-gray-200">Air</span> - Hot reloading during development</li>
			</ul>
			<div class="mt-8 pt-4 border-t border-gray-700">
				<a href="/" class="text-blue-400 hover:text-blue-300 inline-flex items-center transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Back to home
				</a>
			</div>
		</div>
	}
}
